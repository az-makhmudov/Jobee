# Environment
NODE_ENV=development
LOG_LEVEL=info

# Backend API
API_HOST=127.0.0.1
API_PORT=3000

# Web Application
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Database (PostgreSQL)
# Local: postgresql://postgres:postgres@localhost:5432/job_agent
# Neon (use an owner-approved environment; verify current service terms): postgresql://<user>:<password>@<endpoint>.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_agent
DATABASE_SSL=false
# Isolated test database URL for mutation-capable integration tests (NEVER target production Neon or primary dev db)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobee_test_isolated

# Worker
WORKER_POLL_INTERVAL_MS=5000

# AI (server-managed Gemini; disabled is for offline verification)
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Email Intelligence & OAuth
# Random secret for AES-256-GCM integration token storage (key derived by SHA-256).
# Generate with: openssl rand -hex 32; retain the same key for existing encrypted records.
EMAIL_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/email/accounts/gmail/callback

# Google Calendar Integration (Optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3000/api/calendar/google/callback

# Autonomous Orchestrator & Scheduling (JOB-P5-T02)
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_POLL_INTERVAL_MS=15000
DISCOVERY_INTERVAL_MINUTES=60
EMAIL_SYNC_INTERVAL_MINUTES=15
REMINDERS_INTERVAL_MINUTES=30
RATE_LIMIT_DAILY_APPLICATIONS_DEFAULT=10

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your_32_byte_better_auth_secret_here
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=owner@example.test
INVITE_ONLY_REGISTRATION=true

# Transactional Email (Verification & Password Reset via Resend or SMTP)
RESEND_API_KEY=
# Sender Address: Both EMAIL_FROM and SMTP_FROM are supported.
# NOTE: If using Resend without a verified domain, use Resend's testing sender: Jobee <onboarding@resend.dev>
# For production with a verified domain, use: Jobee <notifications@yourdomain.com>
EMAIL_FROM=Jobee <onboarding@resend.dev>
SMTP_FROM=Jobee <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Document Storage (Local disk or Cloudflare R2 / S3 Object Storage)
# Shared container storage: use owner-configured S3-compatible storage such as R2.
STORAGE_BACKEND=local
# For Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=jobee-documents
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<r2_access_key_id>
# S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# Product evolution rollout switches. Daily search additionally requires candidate opt-in.
BATCH_PREPARATION_ENABLED=true
# Also gates job-scoped Apply with Jobee and intent dispatch. Never grants candidate consent.
SELECTED_SUBMISSIONS_ENABLED=true
# Versioned Autopilot rollout; explicit candidate policy acceptance is still required.
AUTOPILOT_ENABLED=false
