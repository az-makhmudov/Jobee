# Environment
NODE_ENV=development
LOG_LEVEL=info

# Backend API
API_HOST=127.0.0.1
API_PORT=3000

# Web Application
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_agent

# Worker
WORKER_POLL_INTERVAL_MS=5000

# AI Provider (Optional: 'disabled' | 'gemini' | 'openai')
AI_PROVIDER=disabled
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Email Intelligence & OAuth
# 32-byte hexadecimal encryption key for AES-256-GCM token storage at rest (min 32 characters, high entropy)
# Generate with: openssl rand -hex 32
EMAIL_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/email/accounts/gmail/callback

# Google Calendar Integration (Optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3000/api/calendar/google/callback

# Autonomous Orchestrator & Scheduling (JOB-P5-T02)
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_POLL_INTERVAL_MS=15000
DISCOVERY_INTERVAL_MINUTES=60
EMAIL_SYNC_INTERVAL_MINUTES=15
REMINDERS_INTERVAL_MINUTES=30
RATE_LIMIT_DAILY_APPLICATIONS_DEFAULT=10

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your_32_byte_better_auth_secret_here
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INVITE_ONLY_REGISTRATION=true

# Transactional Email (Verification & Password Reset)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Jobee <notifications@jobee.local>
